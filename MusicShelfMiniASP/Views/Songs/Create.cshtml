@model MusicShelfMiniASP.SongCreateViewModel

@{
    ViewData["Title"] = "Добави песен";
}

<h2>Добави песен</h2>

<form asp-action="Create" method="post">
    <div class="mb-3">
        <label asp-for="Title" class="form-label">Заглавие</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AlbumId" class="form-label">Албум</label>
        <select asp-for="AlbumId" asp-items="Model.Albums" class="form-select">
            <option value="">-- Без албум --</option>
        </select>
    </div>

    <div class="mb-3">
        <label asp-for="SongWriterId" class="form-label">Автор на песента</label>
        <select asp-for="SongWriterId" asp-items="Model.SongWriters" class="form-select">
            <option value="">-- Неизвестен --</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Запази</button>
    <a asp-action="Index" class="btn btn-secondary">Назад към списъка</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}