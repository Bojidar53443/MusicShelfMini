@{
}
<h2>Списък с песни</h2>

<p>
    <a asp-action="Seed" class="btn btn-primary">Добави примерна песен</a>
</p>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Заглавие</th>
            <th>Автор</th>
            <th>Албум</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var song in Model)
        {
            <tr>
                <td>@song.Id</td>
                <td>@song.Title</td>
                <td>@(song.Author?.Name ?? "Няма")</td>
                <td>@(song.Album?.Title ?? "Няма")</td>
            </tr>
        }
    </tbody>
</table>
