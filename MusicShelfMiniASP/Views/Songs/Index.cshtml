@model MusicShelfMiniASP.ViewModels.Songs.SongsIndexViewModel

<h2>Списък с песни</h2>

@if (!Model.Songs.Any())
{
    <p>Няма добавени песни.</p>
}
else
{
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>Заглавие</th>
                <th>Албум</th>
                <th>Автор на песента</th>
                <th>Брой ревюта</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var song in Model.Songs)
            {
                <tr>
                    <td>@song.SongId</td>
                    <td>@song.Title</td>
                    <td>@song.AlbumTitle</td>
                    <td>@song.SongWriterName</td>
                    <td>@song.ReviewsCount</td>
                </tr>
            }
        </tbody>
    </table>
}